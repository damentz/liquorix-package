# Bootstrap debian/control if it doesn't exist yet, needed by dpkg-buildapi
ifeq (,$(wildcard debian/control))
  _ := $(shell debian/bin/gencontrol.py 2>/dev/null)
endif

include /usr/share/dpkg/default.mk

BUILD_DIR = debian/build
STAMPS_DIR = debian/stamps
DISTRIBUTOR := liquorix

-include debian/rules.defs.local
