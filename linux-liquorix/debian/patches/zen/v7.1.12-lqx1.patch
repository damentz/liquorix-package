+static inline void sched_set_rq_online(struct rq *rq, int cpu)
+{
+	unsigned long flags;
+
+	raw_spin_rq_lock_irqsave(rq, flags);
+	set_rq_online(rq);
+	raw_spin_rq_unlock_irqrestore(rq, flags);
+}
