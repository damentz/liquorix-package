+	if (prio == last_prio)
+		return;
+
+	sched_rq_set_prio(rq, prio);
+
+	int cpu = cpu_of(rq);
+	bool set = prio > last_prio;
+	int low = set ? last_prio : prio;
+	int high = set ? prio : last_prio;
+
+	if (IDLE_TASK_SCHED_PRIO == high) {
+		high -= 2;
+		if (set)
+			sched_set_idle_mask(cpu);
+		else
+			sched_clear_idle_mask(cpu);
