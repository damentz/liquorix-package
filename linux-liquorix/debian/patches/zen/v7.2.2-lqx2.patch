+		if (insert_point == res) {
+			insert_point = ttm_lru_prev_res(insert_point);
+			WARN_ON(insert_point->bo->base.resv !=
+				res->bo->base.resv);
+			continue;
+		}
+		if (insert_point->bo->bulk_move_order <=
+		    res->bo->bulk_move_order)
