+	/* Only answer the IOMMU group isolation query (REQ_ACS_FLAGS) */
+	if (acs_flags != (PCI_ACS_SV | PCI_ACS_RR | PCI_ACS_CR | PCI_ACS_UF))
+		return -ENOTTY;
