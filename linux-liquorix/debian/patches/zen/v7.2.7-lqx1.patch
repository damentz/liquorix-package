+enum {
+#ifdef CONFIG_SCHED_SMT
+	SCHED_CPU_AFFINITY_SMT,
+#endif
+	SCHED_CPU_AFFINITY_CLUSTER,
+	SCHED_CPU_AFFINITY_LLC,
+	SCHED_CPU_AFFINITY_CORE,
+	SCHED_CPU_AFFINITY_OTHER,
+	NR_CPU_AFFINITY_LEVELS
