+__read_mostly int sysctl_resched_latency_warn_ms = 100;
+__read_mostly int sysctl_resched_latency_warn_once = 1;
+
+#define ALT_SCHED_VERSION "v7.2-r0"
+
+#define STOP_PRIO		(MAX_RT_PRIO - 1)
+
+/*
