+static int __init pcie_acs_override_setup(char *p)
+{
+	if (!p)
+		return -EINVAL;
+
+	while (*p) {
+		size_t len = strcspn(p, ",");
+
+		if (len == strlen("downstream") &&
+		    !strncmp(p, "downstream", len)) {
+			acs_on_downstream = true;
+		} else if (len == strlen("multifunction") &&
+			   !strncmp(p, "multifunction", len)) {
