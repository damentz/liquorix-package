#!/bin/sh -e

version=@abiname@@localversion@
image_path=/boot/@image-stem@-$version

if [ "$1" != configure ]; then
    exit 0
fi

depmod $version

if [ -f /lib/modules/$version/.fresh-install ]; then
    change=install
else
    change=upgrade
fi
linux-update-symlinks $change $version $image_path
rm -f /lib/modules/$version/.fresh-install

if [ -d /etc/kernel/postinst.d ]; then
    DEB_MAINT_PARAMS="$*" run-parts --report --exit-on-error --arg=$version \
	      --arg=$image_path /etc/kernel/postinst.d
fi

# Add tools to PATH if binaries exist in kernel headers
mkdir -p /etc/profile.d
cat <<'EOF' > /etc/profile.d/liquorix-tools.sh
for tool in perf/perf \
            power/cpupower/cpupower \
            power/x86/turbostat/turbostat \
            power/x86/x86_energy_perf_policy/x86_energy_perf_policy; do
    KERNEL_TOOL_PATH="/usr/src/linux-headers-$(uname -r)/tools/$tool"
    test -f "$KERNEL_TOOL_PATH" && PATH="${KERNEL_TOOL_PATH%/*}:$PATH"
done
EOF

# Liquorix distributes IRQs in-kernel; irqbalance works against that and costs
# both stability and performance.  Only systemd is handled here -- covering
# every other init system is more trouble than it's worth.  A running
# irqbalance is left alone; the next boot takes care of it.
if command -v systemctl >/dev/null 2>&1; then
    # Non-zero also covers "unit does not exist", hence the fallback.
    irqbalance_state=$(systemctl is-enabled irqbalance.service 2>/dev/null || true)
    case "$irqbalance_state" in
    enabled*)
        if systemctl disable irqbalance.service >/dev/null 2>&1; then
            echo "Disabled irqbalance to improve Liquorix stability and performance."
        fi
        ;;
    esac
fi

exit 0
