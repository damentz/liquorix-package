library identifier: 'lqx@scm', changelog: false, retriever: legacySCM(scm: scm, libraryPath: 'scripts/jenkins')

// Commit and release lists discovered in the first stage, shared by every node
def commit = ''
def sourceRelease = ''
def releases = []
def ubuntuReleases = []
def builtUbuntu = []

pipeline {
    agent none

    options {
        skipDefaultCheckout()
        // Each run updates the shared reprepro repository
        disableConcurrentBuilds()
        timestamps()
    }

    parameters {
        string(name: 'BUILD', defaultValue: '1', description: 'Package build number')
        string(name: 'RELEASES', defaultValue: '', description: 'Releases to build binaries for, e.g. "noble trixie" (empty: all, and upload to the PPA)')
        booleanParam(name: 'SKIP_PUBLISH', defaultValue: false, description: 'Build only, publish nothing (for testing)')
    }

    triggers {
        // GitHub push webhook, only release tags (e.g. 7.2-13) start a build
        GenericTrigger(
            genericVariables: [[key: 'ref', value: '$.ref']],
            tokenCredentialId: 'liquorix-package-webhook',
            regexpFilterText: '$ref',
            regexpFilterExpression: '^refs/tags/\\d+\\.\\d+-\\d+$',
            causeString: 'Tag $ref pushed'
        )
    }

    stages {
        stage('Build Sources') {
            agent { label 'ec2-build' }
            steps {
                script {
                    commit = lqx.prepare('debian')
                    sourceRelease = lqx.envVar('debian', 'source_release')
                    releases = lqx.envVar('debian', 'releases_debian[*]').tokenize()
                    ubuntuReleases = lqx.envVar('debian', 'releases_ubuntu[*]').tokenize()

                    // RELEASES narrows a manual run to a few releases, for testing
                    def only = params.RELEASES.tokenize()
                    if (only) {
                        def unknown = only.findAll { !(it in releases) && !(it in ubuntuReleases) }
                        if (unknown) {
                            error "Unknown releases: ${unknown.join(', ')}"
                        }
                        releases = releases.findAll { it in only }
                        ubuntuReleases = ubuntuReleases.findAll { it in only }
                    }

                    echo "Commit ${commit}, Debian: ${releases.join(', ')}, Ubuntu: ${ubuntuReleases.join(', ')}"
                }

                // Every source package is built in the source release image, so build them all here once
                script { lqx.importKey() }
                sh """
                    make -C liquorix-package DISTRO=debian RELEASE='${sourceRelease}' bootstrap-image
                    make -C liquorix-package BUILD="\$BUILD" build-source-debian build-source-ubuntu
                """
                script {
                    for (r in releases) {
                        stash name: "source-${r}", includes: "liquorix-package/artifacts/debian/${r}/**"
                    }
                }

                stash name: 'source-ubuntu', includes: 'liquorix-package/artifacts/ubuntu/**'
            }
        }

        stage('Build Packages') {
            steps {
                script {
                    def branches = [:]
                    for (r in releases) {
                        def release = r
                        branches[release] = {
                            lqx.buildNode(commit) {
                                unstash "source-${release}"
                                lqx.makeBinary('debian', release)
                                // ponytail: artifacts round-trip through the controller, fine for a handful of releases
                                stash name: "debian-${release}", includes: "liquorix-package/artifacts/debian/${release}/**"
                            }
                        }
                    }
                    // Ubuntu binaries for liquorix.net/ubuntu.  A release that fails to build fails
                    // the run, but Debian and the other Ubuntu releases still publish.
                    for (r in ubuntuReleases) {
                        def release = r
                        branches["ubuntu-${release}"] = {
                            catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                                lqx.buildNode(commit) {
                                    unstash 'source-ubuntu'
                                    lqx.makeBinary('ubuntu', release)
                                    stash name: "ubuntu-${release}", includes: "liquorix-package/artifacts/ubuntu/${release}/**"
                                    builtUbuntu << release
                                }
                            }
                        }
                    }
                    // Launchpad also builds Ubuntu binaries from the sources, so the PPA upload only
                    // needs liquorix.net.  A PPA failure fails the build but still lets the rest publish.
                    // A run narrowed by RELEASES or with SKIP_PUBLISH leaves the PPA alone.
                    if (!params.RELEASES.trim() && !params.SKIP_PUBLISH) {
                        branches['ubuntu-ppa'] = {
                            node('liquorix') {
                                catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                                    lqx.checkoutPackage(commit)
                                    unstash 'source-ubuntu'
                                    withCredentials([file(credentialsId: 'launchpad-ci-credentials', variable: 'LP_CREDENTIALS_FILE')]) {
                                        sh '''
                                            for f in liquorix-package/artifacts/ubuntu/*/*_source.changes; do
                                                grep -q 'BEGIN PGP SIGNATURE' "$f" || { echo "Unsigned: $f, refusing to upload"; exit 1; }
                                            done
                                            # A revoked token makes launchpadlib wait for a browser login, so cap it
                                            timeout 30m make -C liquorix-package BUILD="$BUILD" clean-ppa upload-ppa < /dev/null
                                        '''
                                    }
                                }
                                deleteDir()
                            }
                        }
                    }

                    parallel branches
                }
            }
        }

        stage('Publish Repository') {
            // The repositories live on liquorix.net, so update them in place with the key already there
            agent { label 'liquorix' }
            when {
                beforeAgent true
                expression { !params.SKIP_PUBLISH }
            }
            steps {
                script {
                    lqx.checkoutPackage(commit)
                    if (releases) {
                        for (r in releases) {
                            unstash "debian-${r}"
                        }
                        sh 'liquorix_repo=/var/www/debian/ make -C liquorix-package BUILD="$BUILD" repo-add-debian'
                    }
                    if (builtUbuntu) {
                        for (r in builtUbuntu) {
                            unstash "ubuntu-${r}"
                        }
                        sh 'liquorix_repo=/var/www/ubuntu/ make -C liquorix-package BUILD="$BUILD" repo-add-ubuntu'
                    }
                }
            }
            post {
                // Don't leave a few GB of packages sitting on the web server
                always { deleteDir() }
            }
        }
    }

    post {
        always {
            script { lqx.email() }
        }
    }
}
