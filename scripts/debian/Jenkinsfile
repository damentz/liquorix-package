def REPO_URL = 'https://github.com/damentz/liquorix-package.git'
def KEY_ID = 'C5ADB4F3FEBBCE27A3E54D7D9AE4078033F8024D'

// Commit and release list discovered in the first stage, shared by every node
def commit = ''
def sourceRelease = ''
def releases = []

// Clone liquorix-package at a fixed commit so every node builds the same tree
def checkoutPackage(String url, String sha) {
    sh """
        rm -rf liquorix-package
        git init -q liquorix-package
        git -C liquorix-package fetch -q --depth=1 '${url}' '${sha}'
        git -C liquorix-package checkout -q FETCH_HEAD
    """
}

def importKey(String keyId) {
    withCredentials([file(credentialsId: '6e773de0-6613-45ed-ae4c-7f337540da8d', variable: 'KEY_FILE')]) {
        sh """
            gpg --import "\$KEY_FILE"
            echo 'default-key ${keyId}' >> ~/.gnupg/gpg.conf
        """
    }
}

pipeline {
    agent none

    options {
        // Each run updates the shared reprepro repository
        disableConcurrentBuilds()
    }

    parameters {
        string(name: 'BUILD', defaultValue: '1', description: 'Package build number')
    }

    triggers {
        // GitHub push webhook, only release tags (e.g. 7.2-13) start a build
        GenericTrigger(
            genericVariables: [[key: 'ref', value: '$.ref']],
            tokenCredentialId: 'liquorix-package-webhook',
            regexpFilterText: '$ref',
            regexpFilterExpression: '^refs/tags/\\d+\\.\\d+-\\d+$',
            causeString: 'Tag $ref pushed'
        )
    }

    stages {
        stage('Build Sources') {
            agent { label 'ec2-build' }
            steps {
                script {
                    // Tag pushes build the tag, manual runs build the default branch
                    def tag = env.ref ? env.ref.replaceFirst('^refs/tags/', '') : ''
                    sh "rm -rf liquorix-package && git clone -q --depth=1 ${tag ? "--branch '${tag}'" : ''} '${REPO_URL}' liquorix-package"
                    commit = sh(returnStdout: true, script: 'git -C liquorix-package rev-parse HEAD').trim()
                    def fromEnv = { name -> sh(returnStdout: true, script: "bash -c 'source liquorix-package/scripts/debian/env.sh && echo \"\${${name}}\"'").trim() }
                    def version = fromEnv('version_package')
                    sourceRelease = fromEnv('source_release')
                    releases = fromEnv('releases_debian[*]').split(' ')
                    if (tag && tag != version) {
                        error "Tag ${tag} doesn't match changelog version ${version}"
                    }
                    currentBuild.displayName = "#${env.BUILD_NUMBER} - v${version}.${params.BUILD}"
                    echo "Commit ${commit}, releases: ${releases.join(', ')}"
                }

                // Every source package is built in the source release image, so build them all here once
                script { importKey(KEY_ID) }
                sh """
                    make -C liquorix-package DISTRO=debian RELEASE='${sourceRelease}' bootstrap-image
                    make -C liquorix-package BUILD="\$BUILD" build-source-debian build-source-ubuntu
                """
                script {
                    for (r in releases) {
                        stash name: "source-${r}", includes: "liquorix-package/artifacts/debian/${r}/**"
                    }
                }

                stash name: 'source-ubuntu', includes: 'liquorix-package/artifacts/ubuntu/**'
            }
        }

        stage('Build Packages') {
            steps {
                script {
                    def branches = [:]
                    for (r in releases) {
                        def release = r
                        branches[release] = {
                            node('ec2-build') {
                                checkoutPackage(REPO_URL, commit)
                                importKey(KEY_ID)
                                unstash "source-${release}"
                                sh """
                                    make -C liquorix-package DISTRO=debian RELEASE='${release}' bootstrap-image
                                    make -C liquorix-package DISTRO=debian RELEASE='${release}' BUILD="\$BUILD" build-binary
                                """
                                // ponytail: artifacts round-trip through the controller, fine for a handful of releases
                                stash name: "debian-${release}", includes: "liquorix-package/artifacts/debian/${release}/**"
                            }
                        }
                    }
                    // Launchpad builds Ubuntu binaries itself, so the PPA upload only needs
                    // liquorix.net.  A PPA failure fails the build but still lets Debian publish.
                    branches['ubuntu-ppa'] = {
                        node('liquorix') {
                            catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                                checkoutPackage(REPO_URL, commit)
                                unstash 'source-ubuntu'
                                withCredentials([file(credentialsId: 'launchpad-ci-credentials', variable: 'LP_CREDENTIALS_FILE')]) {
                                    sh '''
                                        for f in liquorix-package/artifacts/ubuntu/*/*_source.changes; do
                                            grep -q 'BEGIN PGP SIGNATURE' "$f" || { echo "Unsigned: $f, refusing to upload"; exit 1; }
                                        done
                                        # A revoked token makes launchpadlib wait for a browser login, so cap it
                                        timeout 30m make -C liquorix-package BUILD="$BUILD" clean-ppa upload-ppa < /dev/null
                                    '''
                                }
                            }
                            deleteDir()
                        }
                    }

                    parallel branches
                }
            }
        }

        stage('Publish Repository') {
            // The repository lives on liquorix.net, so update it in place with the key already there
            agent { label 'liquorix' }
            environment {
                liquorix_repo = '/var/www/debian/'
            }
            steps {
                script {
                    checkoutPackage(REPO_URL, commit)
                    for (r in releases) {
                        unstash "debian-${r}"
                    }
                }
                sh 'make -C liquorix-package BUILD="$BUILD" repo-add-debian'
            }
            post {
                // Don't leave a few GB of packages sitting on the web server
                always { deleteDir() }
            }
        }
    }

    post {
        always {
            emailext to: 'steven@liquorix.net',
                     subject: '$PROJECT_NAME - Build # $BUILD_NUMBER - $BUILD_STATUS!',
                     body: 'Check console output at $BUILD_URL to view the results.',
                     attachLog: true,
                     compressLog: true
        }
    }
}
