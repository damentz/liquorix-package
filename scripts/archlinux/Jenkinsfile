// Commits checked out in the first stage
def lqxCommit = ''
def pkgCommit = ''

pipeline {
    agent {
        label 'ec2-build'
    }

    options {
        // Keep packages around so "Restart from Stage" reuses them instead of rebuilding
        preserveStashes(buildCount: 3)
        timestamps()
    }

    parameters {
        booleanParam(name: 'SKIP_PUBLISH', defaultValue: false, description: 'Build only, publish nothing (for testing)')
    }

    environment {
        ARTIFACT_DIR = 'liquorix-package/artifacts/archlinux/latest'
        LIQUORIX_REPO = '/var/www/archlinux/liquorix/x86_64'
        BASE_IMAGE = 'public.ecr.aws/docker/library/archlinux:base-devel'
    }

    stages {
        stage('Checkout') {
            steps {
                git 'https://github.com/damentz/linux-lqx'
                script {
                    lqxCommit = sh(returnStdout: true, script: 'git rev-parse HEAD').trim()
                    pkgCommit = lqx.clonePackage()
                    echo "linux-lqx ${lqxCommit}, liquorix-package ${pkgCommit}"
                    def pkgver = sh(returnStdout: true, script: "grep -Po '^pkgver=\\K.*' PKGBUILD").trim()
                    def pkgrel = sh(returnStdout: true, script: "grep -Po '^pkgrel=\\K.*' PKGBUILD").trim()
                    currentBuild.displayName = "#${env.BUILD_NUMBER} - v${pkgver}-${pkgrel}"
                    lqx.saveState(lqx: lqxCommit, pkg: pkgCommit, version: "${pkgver}-${pkgrel}")
                }
            }
        }

        stage('Build Package') {
            steps {
                script {
                    // "Restart from Stage" lands on a fresh node without Checkout's clones or variables,
                    // so check out the same commits again
                    if (!pkgCommit) {
                        def state = lqx.loadState()
                        lqxCommit = state.lqx
                        pkgCommit = state.pkg
                        currentBuild.displayName = "#${env.BUILD_NUMBER} - v${state.version}"
                        sh """
                            git init -q .
                            git fetch -q --depth=1 https://github.com/damentz/linux-lqx '${lqxCommit}'
                            git checkout -q -f FETCH_HEAD
                        """
                        lqx.checkoutPackage(pkgCommit)
                    }
                }
                sh 'gpg --locate-keys torvalds@kernel.org gregkh@kernel.org'
                script { lqx.importKey() }

                sh '''
                    make -C liquorix-package bootstrap-arch build-binary-arch
                    tar -tf "$ARTIFACT_DIR/liquorix.tar" | grep -q '\\.sig$' || { echo 'Packages are unsigned, refusing to publish'; exit 1; }
                '''

                stash name: 'artifact', includes: "$ARTIFACT_DIR/**/*"
            }
        }

        stage('Publish Repository') {
            when {
                expression { !params.SKIP_PUBLISH }
            }
            steps {
                withCredentials([sshUserPrivateKey(
                    credentialsId: 'LiquorixSSHPrivate',
                    keyFileVariable: 'SSH_KEY',
                    usernameVariable: 'SSH_USER'
                )]) {
                    unstash name: 'artifact'

                    sh '''
                        SSH_ARGS=( -i "$SSH_KEY" -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o 'ConnectionAttempts=10' )
                        scp ${SSH_ARGS[@]} "$ARTIFACT_DIR/liquorix.tar" $SSH_USER@origin.liquorix.net:~/
                        ssh ${SSH_ARGS[@]} $SSH_USER@origin.liquorix.net "mkdir -vp $LIQUORIX_REPO && cd $LIQUORIX_REPO && tar -xvf ~/liquorix.tar"
                    '''
                }
            }
        }
    }

    post {
        always {
            script { lqx.email() }
        }
    }
}
