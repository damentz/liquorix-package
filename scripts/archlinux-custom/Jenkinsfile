pipeline {
    agent {
        label 'ec2-build'
    }

    options {
        timestamps()
        // The packages are only there to be downloaded and installed by hand
        buildDiscarder(logRotator(artifactNumToKeepStr: '3'))
    }

    parameters {
        string(name: 'FEATURE_BRANCHES', defaultValue: '', description: 'zen-kernel branches to merge on top of the main branch of their series, in order, e.g. "7.2/prjc-next 7.2/zram"')
        string(name: 'BRANCH', defaultValue: '', description: 'liquorix-package branch to build from (empty: the default branch)')
    }

    environment {
        ARTIFACT_DIR = 'liquorix-package/artifacts/archlinux/latest'
        BASE_IMAGE = 'public.ecr.aws/docker/library/archlinux:base-devel'
    }

    stages {
        stage('Checkout') {
            steps {
                script {
                    // The first run of a new job only registers the parameters
                    if (!params.FEATURE_BRANCHES?.trim()) {
                        error 'FEATURE_BRANCHES is empty'
                    }
                    echo "liquorix-package ${lqx.clonePackage(params.BRANCH.trim())}"
                    currentBuild.displayName = "#${env.BUILD_NUMBER} - ${params.FEATURE_BRANCHES.trim()}"
                }
            }
        }

        stage('Build Package') {
            steps {
                sh 'gpg --locate-keys torvalds@kernel.org gregkh@kernel.org'
                // The keyring is only mounted into the build container when it has a signing key
                script { lqx.importKey() }

                // FEATURE_BRANCHES and BUILD_NUMBER reach scripts/archlinux/merge-branches.sh through the environment
                sh 'make -C liquorix-package bootstrap-arch build-binary-arch'

                archiveArtifacts artifacts: "$ARTIFACT_DIR/*.pkg.tar.zst", excludes: '**/*-docs-*'
            }
        }
    }

    post {
        always {
            script { lqx.email() }
        }
    }
}
