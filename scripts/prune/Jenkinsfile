library identifier: 'lqx@scm', retriever: legacySCM(scm: scm, libraryPath: 'scripts/jenkins')

pipeline {
    // The repositories live on liquorix.net.  Its single executor also keeps this from
    // running in the middle of a Debian, Ubuntu or Fedora publish.
    agent { label 'liquorix' }

    options {
        skipDefaultCheckout()
        disableConcurrentBuilds()
        timestamps()
    }

    parameters {
        string(name: 'SERIES', defaultValue: '3', description: 'Newest kernel series to keep (7.2, 7.1, ...), in every release')
        string(name: 'KEEP', defaultValue: '3', description: 'Builds to keep per kernel series')
        booleanParam(name: 'DRY_RUN', defaultValue: false, description: 'Only list what would be removed')
    }

    stages {
        stage('Prune Repositories') {
            steps {
                script { lqx.clonePackage() }
                sh '''
                    df -h /var/www
                    make -C liquorix-package repo-prune SERIES="$SERIES" KEEP="$KEEP" DRY_RUN="$DRY_RUN"
                    df -h /var/www
                '''
            }
            post {
                always { deleteDir() }
            }
        }
    }
}
