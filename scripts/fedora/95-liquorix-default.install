#!/bin/sh
# kernel-install plugin: keep the newest Liquorix kernel as the boot default,
# even after a stock Fedora kernel is installed. Runs after 20-grub.install.
# Honors UPDATEDEFAULT=no in /etc/sysconfig/kernel.

COMMAND="$1"
KERNEL_VERSION="$2"

[ "$COMMAND" = add ] || [ "$COMMAND" = remove ] || exit 0
command -v grubby >/dev/null 2>&1 || exit 0

UPDATEDEFAULT=yes
# shellcheck disable=SC1091
[ -f /etc/sysconfig/kernel ] && . /etc/sysconfig/kernel
[ "$UPDATEDEFAULT" = no ] && exit 0

# On remove, the kernel going away must not be picked
skip=
[ "$COMMAND" = remove ] && skip="/boot/vmlinuz-$KERNEL_VERSION"
# shellcheck disable=SC2010  # kernel versions have no odd characters
newest=$(ls /boot/vmlinuz-*lqx* 2>/dev/null | grep -vxF "${skip:-/nonexistent}" | sort -V | tail -n1)
[ -n "$newest" ] || exit 0

grubby --set-default="$newest" >/dev/null || true
exit 0
