def REPO_URL = 'https://github.com/damentz/liquorix-package.git'
def KEY_ID = 'C5ADB4F3FEBBCE27A3E54D7D9AE4078033F8024D'

// Commit and release lists discovered in the first stage, shared by every node
def commit = ''
def releases = []
def stable = []
def built = []

// Clone liquorix-package at a fixed commit so every node builds the same tree
def checkoutPackage(String url, String sha) {
    sh """
        rm -rf liquorix-package
        git init -q liquorix-package
        git -C liquorix-package fetch -q --depth=1 '${url}' '${sha}'
        git -C liquorix-package checkout -q FETCH_HEAD
    """
}

def importKey(String keyId) {
    withCredentials([file(credentialsId: '6e773de0-6613-45ed-ae4c-7f337540da8d', variable: 'KEY_FILE')]) {
        sh """
            gpg --import "\$KEY_FILE"
            echo 'default-key ${keyId}' >> ~/.gnupg/gpg.conf
        """
    }
}

pipeline {
    agent none

    options {
        // Each run updates the shared dnf repository
        disableConcurrentBuilds()
        timestamps()
    }

    parameters {
        string(name: 'BUILD', defaultValue: '1', description: 'Package build number')
        string(name: 'RELEASES', defaultValue: '', description: 'Fedora releases to build, e.g. "44 45" (empty: detect from Bodhi)')
        string(name: 'BRANCH', defaultValue: '', description: 'Branch to build on manual runs (empty: default branch)')
    }

    triggers {
        // GitHub push webhook, only release tags (e.g. 7.2-13) start a build
        GenericTrigger(
            genericVariables: [[key: 'ref', value: '$.ref']],
            tokenCredentialId: 'liquorix-package-webhook',
            regexpFilterText: '$ref',
            regexpFilterExpression: '^refs/tags/\\d+\\.\\d+-\\d+$',
            causeString: 'Tag $ref pushed'
        )
    }

    stages {
        stage('Preflight') {
            // Fail in seconds, not after the EC2 builds, if publishing can't work
            agent { label 'liquorix' }
            steps {
                sh '''
                    test -w /var/www/fedora || { echo "/var/www/fedora missing or not writable"; exit 1; }
                    docker info > /dev/null
                '''
            }
        }

        stage('Prepare') {
            agent { label 'ec2-build' }
            steps {
                script {
                    // Tag pushes build the tag, manual runs build BRANCH or the default branch
                    def tag = env.ref ? env.ref.replaceFirst('^refs/tags/', '') : ''
                    def ref = tag ?: params.BRANCH.trim()
                    sh "rm -rf liquorix-package && git clone -q --depth=1 ${ref ? "--branch '${ref}'" : ''} '${REPO_URL}' liquorix-package"
                    commit = sh(returnStdout: true, script: 'git -C liquorix-package rev-parse HEAD').trim()
                    def version = sh(returnStdout: true, script: "bash -c 'source liquorix-package/scripts/fedora/env.sh && echo \"\${version_package}\"'").trim()
                    if (tag && tag != version) {
                        error "Tag ${tag} doesn't match changelog version ${version}"
                    }

                    // Current (stable) releases must build, branched and rawhide may fail
                    stable = sh(returnStdout: true, script: 'liquorix-package/scripts/fedora/releases.sh current').tokenize()
                    releases = params.RELEASES.trim() ?
                        params.RELEASES.tokenize() :
                        sh(returnStdout: true, script: 'liquorix-package/scripts/fedora/releases.sh').tokenize()

                    currentBuild.displayName = "#${env.BUILD_NUMBER} - v${version}.${params.BUILD}"
                    echo "Commit ${commit}, releases: ${releases.join(', ')}, stable: ${stable.join(', ')}"
                }
            }
        }

        stage('Build Packages') {
            steps {
                script {
                    def branches = [:]
                    for (r in releases) {
                        def release = r
                        def build = {
                            // EC2 hosts are destroyed after each run, so no workspace cleanup
                            node('ec2-build') {
                                checkoutPackage(REPO_URL, commit)
                                importKey(KEY_ID)
                                sh """
                                    make -C liquorix-package DISTRO=fedora RELEASE='${release}' bootstrap-image
                                    make -C liquorix-package DISTRO=fedora RELEASE='${release}' BUILD="\$BUILD" build-binary
                                """
                                // Signing is best-effort for local builds, never publish unsigned RPMs
                                sh """
                                    gpg --export --armor '${KEY_ID}' > pubkey.asc
                                    docker run --rm --user root -v "\$PWD/pubkey.asc":/pubkey.asc:ro \
                                        -v "\$PWD/liquorix-package/artifacts/fedora/${release}":/rpms:ro \
                                        'liquorix_amd64/fedora/${release}' \
                                        sh -c 'rpm --import /pubkey.asc && rpm -K /rpms/*.rpm' > rpm-check.txt
                                    cat rpm-check.txt
                                    if grep -v 'signatures OK' rpm-check.txt; then
                                        echo 'Unsigned or badly signed RPMs, refusing to publish'
                                        exit 1
                                    fi
                                """
                                // ponytail: artifacts round-trip through the controller, fine for a handful of releases
                                stash name: "fedora-${release}", includes: "liquorix-package/artifacts/fedora/${release}/*.rpm"
                                built << release
                            }
                        }
                        branches[release] = stable.contains(release) ? build : {
                            catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') { build() }
                        }
                    }
                    parallel branches
                }
            }
        }

        stage('Publish Repository') {
            // The repository lives on liquorix.net, so update it in place with the key already there
            agent { label 'liquorix' }
            environment {
                liquorix_repo = '/var/www/fedora'
                liquorix_gpg_key = "${KEY_ID}"
            }
            steps {
                script {
                    checkoutPackage(REPO_URL, commit)
                    for (r in built) {
                        unstash "fedora-${r}"
                    }
                }
                sh 'make -C liquorix-package repo-add-fedora'
            }
            post {
                // Don't leave a few GB of packages sitting on the web server
                always { deleteDir() }
            }
        }
    }

    post {
        always {
            emailext to: 'steven@liquorix.net',
                     subject: '$PROJECT_NAME - Build # $BUILD_NUMBER - $BUILD_STATUS!',
                     body: 'Check console output at $BUILD_URL to view the results.',
                     attachLog: true,
                     compressLog: true
        }
    }
}
