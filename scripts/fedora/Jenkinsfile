// Commit and release lists discovered in the first stage, shared by every node
def commit = ''
def releases = []
def stable = []
def built = []

// "Restart from Stage" skips the stages before it and the variables they set, so read them back
// from Prepare's stash, along with what earlier attempts finished.  Needs a workspace.
def restore = {
    def state = lqx.loadState()
    commit = state.commit
    releases = state.releases.tokenize()
    stable = state.stable.tokenize()
    built = lqx.done('fedora', releases)
    echo "Restarted at ${commit}, already built: ${built.join(', ') ?: 'nothing'}"
}

pipeline {
    agent none

    options {
        // Each run updates the shared dnf repository
        disableConcurrentBuilds()
        // Keep packages around so "Restart from Stage" reuses them instead of rebuilding
        preserveStashes(buildCount: 3)
        timestamps()
    }

    parameters {
        string(name: 'BUILD', defaultValue: '1', description: 'Package build number')
        string(name: 'RELEASES', defaultValue: '', description: 'Fedora releases to build, e.g. "44 45" (empty: detect from Bodhi)')
        string(name: 'BRANCH', defaultValue: '', description: 'Branch to build on manual runs (empty: default branch)')
        booleanParam(name: 'SKIP_PUBLISH', defaultValue: false, description: 'Build only, publish nothing (for testing)')
    }

    triggers {
        // GitHub push webhook, only release tags (e.g. 7.2-13) start a build
        GenericTrigger(
            genericVariables: [[key: 'ref', value: '$.ref']],
            tokenCredentialId: 'liquorix-package-webhook',
            regexpFilterText: '$ref',
            regexpFilterExpression: '^refs/tags/\\d+\\.\\d+-\\d+$',
            causeString: 'Tag $ref pushed'
        )
    }

    stages {
        stage('Preflight') {
            // Fail in seconds, not after the EC2 builds, if publishing can't work
            agent { label 'liquorix' }
            when {
                beforeAgent true
                expression { !params.SKIP_PUBLISH }
            }
            steps {
                sh '''
                    test -w /var/www/fedora || { echo "/var/www/fedora missing or not writable"; exit 1; }
                    docker info > /dev/null
                '''
            }
        }

        stage('Prepare') {
            // A few seconds of work, not worth launching an EC2 host for
            agent { label 'liquorix' }
            steps {
                script {
                    commit = lqx.prepare('fedora', params.BRANCH.trim())

                    // Current (stable) releases must build, branched and rawhide may fail
                    stable = sh(returnStdout: true, script: 'liquorix-package/scripts/fedora/releases.sh current').tokenize()
                    releases = params.RELEASES.trim() ?
                        params.RELEASES.tokenize() :
                        sh(returnStdout: true, script: 'liquorix-package/scripts/fedora/releases.sh').tokenize()

                    echo "Commit ${commit}, releases: ${releases.join(', ')}, stable: ${stable.join(', ')}"
                    lqx.saveState(commit: commit, releases: releases.join(' '), stable: stable.join(' '))
                }
            }
            post {
                // Later stages only need the commit and release lists
                always { deleteDir() }
            }
        }

        stage('Build Packages') {
            steps {
                script {
                    if (!commit) {
                        node('liquorix') { restore() }
                    }

                    // A release that fails to build, or loses its spot agent, still lets the others
                    // publish.  Only a stable release failing fails the run.  "Restart from Stage"
                    // here builds only what's missing.
                    def branches = [:]
                    for (r in releases - built) {
                        def release = r
                        branches[release] = {
                            catchError(buildResult: stable.contains(release) ? 'FAILURE' : 'UNSTABLE', stageResult: 'FAILURE') {
                                lqx.buildNode(commit) {
                                    lqx.makeBinary('fedora', release)
                                    // Signing is best-effort for local builds, never publish unsigned RPMs
                                    sh """
                                        gpg --export --armor '${lqx.KEY_ID}' > pubkey.asc
                                        docker run --rm --user root -v "\$PWD/pubkey.asc":/pubkey.asc:ro \
                                            -v "\$PWD/liquorix-package/artifacts/fedora/${release}":/rpms:ro \
                                            'liquorix_amd64/fedora/${release}' \
                                            sh -c 'rpm --import /pubkey.asc && rpm -K /rpms/*.rpm' > rpm-check.txt
                                        cat rpm-check.txt
                                        if grep -v 'signatures OK' rpm-check.txt; then
                                            echo 'Unsigned or badly signed RPMs, refusing to publish'
                                            exit 1
                                        fi
                                    """
                                    // ponytail: artifacts round-trip through the controller, fine for a handful of releases
                                    stash name: "fedora-${release}", includes: "liquorix-package/artifacts/fedora/${release}/*.rpm"
                                    lqx.markDone('fedora', release)
                                    built << release
                                }
                            }
                        }
                    }
                    if (branches) {
                        parallel branches
                    }

                    def missing = releases - built
                    if (missing) {
                        currentBuild.description = "Not built: ${missing.join(' ')}"
                    }
                }
            }
        }

        stage('Publish Repository') {
            // The repository lives on liquorix.net, so update it in place with the key already there
            agent { label 'liquorix' }
            when {
                beforeAgent true
                expression { !params.SKIP_PUBLISH }
            }
            steps {
                script {
                    if (!commit) {
                        restore()
                    }
                    // Publishing replaces each built release's tree, packages already there included
                    lqx.checkoutPackage(commit)
                    for (r in built) {
                        unstash "fedora-${r}"
                    }
                    if (built) {
                        sh "liquorix_repo=/var/www/fedora liquorix_gpg_key=${lqx.KEY_ID} make -C liquorix-package repo-add-fedora"
                    }
                }
            }
            post {
                // Don't leave a few GB of packages sitting on the web server
                always { deleteDir() }
            }
        }
    }

    post {
        always {
            script { lqx.email() }
        }
    }
}
