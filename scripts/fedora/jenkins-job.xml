<?xml version='1.1' encoding='UTF-8'?>
<!-- Jenkins job for scripts/fedora/Jenkinsfile.  Create or update with:
     java -jar jenkins-cli.jar -s https://liquorix.net/jenkins/ create-job liquorix-fedora < jenkins-job.xml
     java -jar jenkins-cli.jar -s https://liquorix.net/jenkins/ update-job liquorix-fedora < jenkins-job.xml
     The tag webhook trigger comes from the Jenkinsfile and is registered by the first run. -->
<flow-definition plugin="workflow-job">
  <description>Liquorix Fedora RPMs, published to https://liquorix.net/fedora/</description>
  <keepDependencies>false</keepDependencies>
  <!-- Mirrors the Jenkinsfile parameters so the very first run already honors RELEASES -->
  <properties>
    <hudson.model.ParametersDefinitionProperty>
      <parameterDefinitions>
        <hudson.model.StringParameterDefinition>
          <name>BUILD</name>
          <description>Package build number</description>
          <defaultValue>1</defaultValue>
          <trim>true</trim>
        </hudson.model.StringParameterDefinition>
        <hudson.model.StringParameterDefinition>
          <name>RELEASES</name>
          <description>Fedora releases to build, e.g. "44 45" (empty: detect from Bodhi)</description>
          <defaultValue></defaultValue>
          <trim>true</trim>
        </hudson.model.StringParameterDefinition>
        <hudson.model.StringParameterDefinition>
          <name>BRANCH</name>
          <description>Branch to build on manual runs (empty: default branch)</description>
          <defaultValue></defaultValue>
          <trim>true</trim>
        </hudson.model.StringParameterDefinition>
      </parameterDefinitions>
    </hudson.model.ParametersDefinitionProperty>
  </properties>
  <definition class="org.jenkinsci.plugins.workflow.cps.CpsScmFlowDefinition" plugin="workflow-cps">
    <scm class="hudson.plugins.git.GitSCM" plugin="git">
      <configVersion>2</configVersion>
      <userRemoteConfigs>
        <hudson.plugins.git.UserRemoteConfig>
          <url>https://github.com/damentz/liquorix-package.git</url>
        </hudson.plugins.git.UserRemoteConfig>
      </userRemoteConfigs>
      <branches>
        <hudson.plugins.git.BranchSpec>
          <name>*/7.2/master</name>
        </hudson.plugins.git.BranchSpec>
      </branches>
      <doGenerateSubmoduleConfigurations>false</doGenerateSubmoduleConfigurations>
      <submoduleCfg class="empty-list"/>
      <extensions/>
    </scm>
    <scriptPath>scripts/fedora/Jenkinsfile</scriptPath>
    <lightweight>true</lightweight>
  </definition>
  <triggers/>
  <disabled>false</disabled>
</flow-definition>
